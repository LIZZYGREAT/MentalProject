{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindflow.local/schemas/freeze-manifest-v1.json",
  "title": "MindFlow Representation Semantics Freeze Manifest",
  "type": "object",
  "required": ["representation_version", "frozen_at", "manual_version", "scenario_bank_version", "gold_set_version", "schema_versions", "included_constructs", "revised_constructs", "simplified_constructs", "dropped_constructs", "field_metrics_ref", "critical_violation_report_ref", "known_open_questions", "git_revision"],
  "properties": {
    "representation_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "manual_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "scenario_bank_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "gold_set_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "schema_versions": {"type": "object", "minProperties": 3, "additionalProperties": {"type": "string"}},
    "included_constructs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "revised_constructs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "simplified_constructs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "dropped_constructs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "field_metrics_ref": {"type": "string", "minLength": 1},
    "critical_violation_report_ref": {"type": "string", "minLength": 1},
    "known_open_questions": {"type": "array", "items": {"type": "string"}},
    "git_revision": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
  },
  "additionalProperties": false
}
