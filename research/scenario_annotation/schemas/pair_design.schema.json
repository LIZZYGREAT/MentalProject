{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindflow.local/schemas/pair-design-v1.json",
  "title": "MindFlow Stage 1 Hidden Pair Design",
  "type": "object",
  "required": ["pair_id", "scenario_ids", "manipulated_factor", "comparison_mode", "pair_kind", "expected_sensitive_constructs", "expected_invariant_constructs", "coverage_tags", "design_notes"],
  "properties": {
    "pair_id": {"type": "string", "minLength": 1},
    "scenario_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "manipulated_factor": {"type": "string", "minLength": 1},
    "comparison_mode": {"enum": ["WITHIN_ANNOTATOR", "BETWEEN_GROUPS"]},
    "pair_kind": {"enum": ["MINIMAL_CONTRAST", "PRESENTATION_EQUIVALENCE", "ORTHOGONAL_CROSS"]},
    "expected_sensitive_constructs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "expected_invariant_constructs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "target_mapping": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "target_variable": {"type": "string", "minLength": 1},
          "record_attribute": {"type": "string", "minLength": 1},
          "left_target_ref": {"type": "string", "minLength": 1},
          "right_target_ref": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "coverage_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "design_notes": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
