# Runtime mode. Production requires a stable, random FLASK_SECRET_KEY.
APP_ENV=development
FLASK_SECRET_KEY=replace-with-a-long-random-secret
APP_DATABASE_PATH=data/app.sqlite3
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=12
MAX_CONTENT_LENGTH=2097152

# Only enable this when requests come through one trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Optional one-time bootstrap. Remove the password after the first successful boot.
BOOTSTRAP_ADMIN_LOGIN_ID=admin@school.edu.cn
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-10-characters

# Production WSGI settings.
APP_BIND=0.0.0.0:8000
WEB_CONCURRENCY=2
WEB_THREADS=4
WEB_TIMEOUT=180

# Feishu OAuth and calendar integration.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Local development only. Production must use a public HTTPS /callback URL.
FEISHU_REDIRECT_URI=http://127.0.0.1:5000/callback
# The app must enable and publish all three scopes in Feishu Open Platform.
FEISHU_OAUTH_SCOPES=auth:user.id:read offline_access calendar:calendar:readonly
# Do not configure user/open/calendar IDs here. Each signed-in user authorizes
# their own Feishu account; the server resolves that account's primary calendar.
