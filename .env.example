# Runtime mode. Production requires a stable, random FLASK_SECRET_KEY.
APP_ENV=development
FLASK_SECRET_KEY=replace-with-a-long-random-secret
APP_DATABASE_PATH=data/app.sqlite3
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=12
MAX_CONTENT_LENGTH=2097152

# DeepSeek V4 Flash event-semantics agent. The agent only extracts bounded
# event features; deterministic rules and explicit user appraisal stay in control.
SEMANTIC_API_ENABLED=true
SEMANTIC_API_PROVIDER=deepseek
SEMANTIC_API_URL=https://api.deepseek.com/chat/completions
SEMANTIC_API_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
SEMANTIC_API_THINKING=false
SEMANTIC_API_TIMEOUT_SECONDS=12
SEMANTIC_API_MAX_TOKENS=900
SEMANTIC_CACHE_PATH=data/semantic_inference.sqlite3

# Only enable this when requests come through one trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Optional one-time bootstrap. Remove the password after the first successful boot.
BOOTSTRAP_ADMIN_LOGIN_ID=admin@school.edu.cn
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-10-characters

# Production WSGI settings.
APP_BIND=0.0.0.0:8000
WEB_CONCURRENCY=2
WEB_THREADS=4
WEB_TIMEOUT=180

# Feishu OAuth and calendar integration.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Local development only. Production must use a public HTTPS /callback URL.
FEISHU_REDIRECT_URI=http://127.0.0.1:5000/callback
# Exact origin allowed to receive OAuth completion postMessage events. When the
# built frontend is served by Flask, this normally matches the redirect origin.
FEISHU_FRONTEND_ORIGIN=http://127.0.0.1:5000
# The app must enable and publish all three scopes in Feishu Open Platform.
FEISHU_OAUTH_SCOPES=auth:user.id:read offline_access calendar:calendar:readonly
# Do not configure user/open/calendar IDs here. Each signed-in user authorizes
# their own Feishu account; the server resolves that account's primary calendar.

# Feishu bot gateway. Keep disabled until the self-built app has bot capability,
# im.message.receive_v1, card.action.trigger, and send-as-bot permission published.
FEISHU_BOT_ENABLED=false
FEISHU_BOT_TRANSPORT=websocket
# Public Web origin used to build one-time binding and calendar connection links.
# Production must use HTTPS, for example https://mindflow.example.edu
FEISHU_BIND_BASE_URL=http://127.0.0.1:5000
FEISHU_BOT_PRIVATE_CHAT_ONLY=true
FEISHU_BIND_TOKEN_TTL_SECONDS=900
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# Persistent care inbox worker. It is a separate process from Flask/Gunicorn.
CARE_WORKER_ENABLED=true
CARE_WORKER_POLL_SECONDS=1
CARE_WORKER_MAX_ATTEMPTS=5
CARE_EVENT_LEASE_SECONDS=120
CARE_EVENT_RETENTION_DAYS=30
CARE_PROACTIVE_INTERVAL_SECONDS=60
CARE_PROACTIVE_LEAD_MINUTES=90
CROSS_DAY_UNFINISHED_MAX_DAYS=3

# General care Agent is deliberately disabled in the MVP. Deterministic tools
# remain available without sending personal context to an external LLM.
CARE_AGENT_ENABLED=false
CARE_AGENT_PROVIDER=
CARE_AGENT_MODEL=
CARE_AGENT_TIMEOUT_SECONDS=15

# Reserved for the later database-token migration. Do not derive this from the
# Feishu App Secret; production should use an independent random/KMS-managed key.
TOKEN_ENCRYPTION_KEY=
