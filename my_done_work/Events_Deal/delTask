    headers = dict()
    for key, value in os.environ.items():
        if key.startswith("HTTP_"):
            headers[key[5:].replace('_',' ')] = value

    def get_from_header(name,def_val = None):
        cont = headers.get(name,def_val)
        if cont != def_val and cont.endswith(','):
            return cont[:-1]
        return cont

    GUID = get_from_header('GUID')
    openID = get_from_header('OPENID')
    token = get_from_header('TOKEN',None)
    if token: _getAccessToken = lambda _: token
    try:
        res = _deleteTask(openID, GUID)
    except Exception as e:
        success(json.dumps(dict(result=str(e))))
    success(json.dumps(dict(result = str(res))))
