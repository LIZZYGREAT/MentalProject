class eventRepr():
    """
    Calendar class to manage calendar events.
    """
    def __init__(self,**kwargs):
        self.eventId = []
        self.summary = None
        self.description = None
        self.startTime = []
        self.endTime = []
        self.location=None
        self.auxiliary = None
        for key,item in kwargs.items():
            setattr(self,key,item)
    def __repr__(self):
        if len(self.eventId) == 1:
            buffer = ''
            buffer += f'({self.eventId[0]})'
            buffer += f'标题：{self.summary}\t'
            if self.description: buffer += f'描述：{self.description}\t'
            dateStart, specStart = self.startTime[0].split(' ')
            dateEnd, specEnd = self.endTime[0].split(' ')
            if dateStart == dateEnd:
                buffer += f'时间：{dateStart} {specStart}-{specEnd} '
            else:
                buffer += f'时间：{self.startTime[0]} - {self.endTime[0]}'
            if self.location:buffer += f'地点：{self.location}\t'
            if self.auxiliary:buffer += f'{self.auxiliary}\t'
            return buffer
        else:
            idPrefix = self.eventId[0].split('_')[0]
            buffer = []
            #buffer.append(f'后续日程ID的前缀为:{idPrefix}')
            flag = False
            def replacement(x):
                nonlocal flag
                if flag:
                    return x.replace(idPrefix[3:-3],'......')
                else:
                    flag = True
                    return x
            buffer.append(f'标题:{self.summary}')
            if self.description: buffer.append(f'描述：{self.description}')
            occurrences = dict() # map time interval to list of dates
            for eventID, timeStart, timeEnd in zip(self.eventId,self.startTime,self.endTime):
                dateStart, specStart = timeStart.split(' ')
                dateEnd, specEnd = timeEnd.split(' ')
                if dateStart == dateEnd:
                    dateDescript = (dateStart,)
                else:
                    dateDescript = (dateStart, dateEnd)
                keyword = specStart + '-' + specEnd
                if keyword not in occurrences:
                    occurrences[keyword] = []
                occurrences[keyword].append((replacement(eventID), dateDescript))
            timeBuffer = []
            prefix = ''
            for specTime, specOccur in occurrences.items():
                if len(specOccur[0][1]) == 1:
                    prefix = '日期:'
                    for eventID, dateDescript in specOccur:
                        timeBuffer.append(f'(ID:{eventID}){dateDescript[0]}')
                    timeBuffer.append(f'具体时间:{specTime}')
                else:
                    prefix = '时间:'
                    for eventID, dateDescript in specOccur:
                        specStart, specEnd = specTime.split('-')
                        timeBuffer.append(f'(ID:{eventID}){dateDescript[0]} {specStart}-{dateDescript[1]} {specEnd}')
            buffer.append(prefix + ','.join(timeBuffer))
            if self.location:buffer.append(f'地点：{self.location}')
            if self.auxiliary:buffer.append(f'{self.auxiliary}')
            return '\t'.join(buffer)
    def __str__(self):
        return self.__repr__()

def _convertTimestampToTimeString(timeStamp:int)->str:
    """
    Convert a timestamp to a time string.
    :param timeStamp: The timestamp to convert.
    :return: The formatted time string.
    """
    timeStruct = time.localtime(timeStamp)
    return time.strftime('%Y-%m-%d %H:%M',timeStruct)

def _convertTimeStringToTimestamp(timeString:str)->int:
    '''
    Convert a time string to a timestamp.
    :param timeString: The time string to convert.
    :return: The timestamp.
    '''
    timeStruct = time.strptime(timeString, '%Y-%m-%d %H:%M')
    return int(time.mktime(timeStruct))

