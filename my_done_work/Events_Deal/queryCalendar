def _timeInfoToStr(timePoint:'time_info')->str:
    if hasattr(timePoint,'date') and timePoint.date:
        return timePoint.date+'全天'
    elif hasattr(timePoint,'timestamp') and timePoint.timestamp:
        timePoint = int(timePoint.timestamp)
        timeStruct = time.localtime(timePoint)
        return time.strftime('%Y-%m-%d %H:%M',timeStruct)
    raise ValueError('Invalid time info format')

def _locationToStr(location:'event_location')->str:
    buffer = ''
    if hasattr(location,'name') and location.name:
        buffer += location.name+','
    if hasattr(location,'address') and location.address:
        buffer += location.address+','
    if hasattr(location,'latitude') and location.latitude:
        buffer += str(location.latitude)+','
    if hasattr(location,'longitude') and location.longitude:
        buffer += str(location.longitude)
    return buffer

def _expandRecurringEvent(calendarID:str, eventID:str, timeInterval:Tuple[Any])->List[Any]:
    """
    Expand a recurring event into its individual occurrences, by finding all its instances
    within the specified time interval.
    :param calendarID: The ID of the calendar.
    :param eventID: The ID of the event to expand.
    :param timeInterval: The time interval to search for occurrences.
        where start and end are timestamps, with type being str, the format is %Y-%m-%d %H:%M
    :return: A tuple, the first is a list of exceptions instances (instances that are different)
        and the second is a list of non-exception instances (instances that are the same).
    Events are rpresented by strings in the form of:
        (eventID)summary, description, occuring time, and location
    """
    url = f'https://open.feishu.cn/open-apis/calendar/v4/calendars/{calendarID}/events/{eventID}/instances'
    startTime, endTime = timeInterval
    startTime = _convertTimeStringToTimestamp(startTime)
    endTime = _convertTimeStringToTimestamp(endTime)
    params = dict(start_time=startTime,
                   end_time=endTime,
                   page_size=500)
    res = requests.get(url, params=params, headers=_generateHeader()).json()
    if res['code'] != 0:
        print(res)
        raise ValueError(f"Error: {res['msg']}")
    instanceList = res['data']['items']
    instanceList = unserialize(instanceList, TypedList[eventInstance])
    Exceptions = TypedList[eventRepr]()
    NonException = eventRepr()
    for instance in instanceList:
        if instance.is_exception:
            curEvent = eventRepr()
            curEvent.eventId = (instance.event_id,)
            curEvent.summary = instance.summary
            curEvent.description = instance.description
            curEvent.location = _locationToStr(instance.location)
            curEvent.startTime = (_timeInfoToStr(instance.start_time),)
            curEvent.endTime = (_timeInfoToStr(instance.end_time),)
            Exceptions.append(curEvent)
        else:
            NonException.eventId.append(instance.event_id)
            NonException.summary = instance.summary
            NonException.description = instance.description
            NonException.location = _locationToStr(instance.location)
            NonException.startTime.append(_timeInfoToStr(instance.start_time))
            NonException.endTime.append(_timeInfoToStr(instance.end_time))
    return Exceptions, NonException

async def _expandRecurringEventAsync(calendarID:str, eventID:str, timeInterval:Tuple[Any], session, max_retries:int = 5)->List[Any]:
    """
    Expand a recurring event into its individual occurrences, by finding all its instances
    within the specified time interval.
    :param calendarID: The ID of the calendar.
    :param eventID: The ID of the event to expand.
    :param timeInterval: The time interval to search for occurrences.
        where start and end are timestamps, with type being str, the format is %Y-%m-%d %H:%M
    :return: A tuple, the first is a list of exceptions instances (instances that are different)
        and the second is a list of non-exception instances (instances that are the same).
    """
    url = f'https://open.feishu.cn/open-apis/calendar/v4/calendars/{calendarID}/events/{eventID}/instances'
    startTime, endTime = timeInterval
    startTime = _convertTimeStringToTimestamp(startTime)
    endTime = _convertTimeStringToTimestamp(endTime)
    params = dict(start_time=startTime,
                   end_time=endTime,
                   page_size=500)
    for attempt in range(max_retries):
        res = await session.get(url, params=params, headers=_generateHeader())
        if res.status == 429:
            await asyncio.sleep(1+random.random())
            continue
        res = await res.json()
        break
    with open('record','a') as file:
        file.write(str(res))
    #if res.status == 429:
    #    raise Exception(f"Failed after {max_retries} retries for {url}")
    if res['code'] != 0:
        raise ValueError(f"Error: {res['msg']}")
    instanceList = res['data'].get('items',[])
    instanceList = unserialize(instanceList, TypedList[eventInstance])
    Exceptions = TypedList[eventRepr]()
    NonException = eventRepr()
    for instance in instanceList:
        if instance.is_exception:
            curEvent = eventRepr()
            curEvent.eventId = (instance.event_id,)
            curEvent.summary = instance.summary
            curEvent.description = instance.description
            curEvent.location = _locationToStr(instance.location)
            curEvent.startTime = (_timeInfoToStr(instance.start_time),)
            curEvent.endTime = (_timeInfoToStr(instance.end_time),)
            Exceptions.append(curEvent)
        else:
            NonException.eventId.append(instance.event_id)
            NonException.summary = instance.summary
            NonException.description = instance.description
            NonException.location = _locationToStr(instance.location)
            NonException.startTime.append(_timeInfoToStr(instance.start_time))
            NonException.endTime.append(_timeInfoToStr(instance.end_time))
    return Exceptions, NonException
    

def _findEvent(calendarID:str, keyword:str='', startTime:str=None, endTime:str=None)->Any:
    """
    Find an event in the calendar using a keyword.
    :param calendarID: The ID of the calendar.
    :param keyword: The keyword to search for, if empty, match all events.
    :param startTime: The start time of the search interval, in the form of %Y-%m-%d %H:%M,
        default set to the start of current month
    :param endTime: The end time of the search interval, in the form of %Y-%m-%d %H:%M,
        default set to the end of current month
    :return: The event found, or None if not found.
    """
    if not startTime:
        startTime = time.strftime('%Y-%m-01 00:00')
    if not endTime:
        endTime = time.strftime('%Y-%m-01 23:59',time.localtime(time.time()+30*24*3600))
    url = f'https://open.feishu.cn/open-apis/calendar/v4/calendars/{calendarID}/events/search'
    params = dict(user_id_type='user_id',
                  page_size = 100)
    headers = _generateHeader()
    body = dict(query=keyword,
                filter = dict(start_time=dict(timestamp=_convertTimeStringToTimestamp(startTime)),
                              end_time=dict(timestamp=_convertTimeStringToTimestamp(endTime))
                ))
    response = requests.post(url, params=params, json=body, headers=headers).json()
    if response['code']:
        raise Exception
    return response['data']['items']

async def _fetchExpand(calendarID:str, eventIDs:str, timeInterval:Tuple[Any])->List[Any]:
    async with aiohttp.ClientSession() as session:
        res = await asyncio.gather(*[_expandRecurringEventAsync(calendarID, eventID, timeInterval, session) for eventID in eventIDs])
    return res

