def _createEvent(calendarID:str, eventDetails)->str:
    """
    Create an event in the calendar and return its ID.
    Details should be in the form of a dictionary.
    details should include:
    - summary: The title of the event, should be str.
    - description: The description of the event, should be str.
    - startTime: The start time of the event, should be time string in the form of %Y-%m-%d %H:%M.
    - endTime: The end time of the event, form:%Y-%m-%d %H:%M.
    - location: The location of the event. Can be none.
    - reminder: The reminder time ahead of the event, in minutes. Default is 15 minutes before.
    """
    url = f'https://open.feishu.cn/open-apis/calendar/v4/calendars/{calendarID}/events'
    curevent = vevent()
    curevent.summary = eventDetails.get('summary','')
    curevent.description = eventDetails.get('description','')
    curevent.start_time = time_info(timestamp=str(_convertTimeStringToTimestamp(eventDetails['startTime'])))
    curevent.end_time = time_info(timestamp=str(_convertTimeStringToTimestamp(eventDetails['endTime'])))
    curevent.vchat = curevent.get_type('vchat')(vc_type='no_meeting')
    curevent.reminders = curevent.get_type('reminders')([reminder(minutes=eventDetails.get('reminder',15))])
    location = eventDetails.get('location',None)
    if location:
        curevent.location = event_location()
        curevent.location.name = location.get('name','')
        curevent.location.address = location.get('address','')
        for descript in (curevent.location.name, curevent.location.address):
            res = _getCoord(descript)
            if res:
                curevent.location.latitude, curevent.location.longitude = res
    res = requests.post(url,json=curevent.serialize(),headers=_generateHeader()).json()
    if res['code']:
        raise ValueError(f"Error: {res['msg']}")
    return res['data']['event']['event_id']
    

