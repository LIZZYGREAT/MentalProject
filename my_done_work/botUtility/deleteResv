convert_time = lambda x:time.localtime(x//1000)
class reservation:
    def __init__(self,data):
        self.status=data['resvStatus']
        self.beginTime = convert_time(data['resvBeginTime'])
        self.endTime = convert_time(data['resvEndTime'])
        self.realEndTime = convert_time(data['resvEndRealTime'])
        self.checkTime = convert_time(data['resvCheckTime'])
        self.resvMembers = [i['trueName']+i['logonName'] for i in data['resvMemberInfoList']]
        location = data['resvDevInfoList'][0]
        self.resvID = data['resvID']
        self.uuID = data['uuID']
        self.Location = location['labName']+' '+location['roomName']+' '+location['devName']+' ID:'+location['devID']
    def __str__(self):
        buffer = '预约ID: '+self.resvID+' '
        buffer += f'UUID:{self.uuID}'
        buffer += '状态:'
        for k,v in status_map.items():
            if k&self.status:
                buffer += v+' '
        buffer += time.strftime('%m-%d %H:%M',self.beginTime)+'-'
        buffer += time.strftime('%H:%M',self.endTime)+' '
        buffer += '实际结束:'+time.strftime('%H:%M',self.realEndTime)+' '
        buffer += '预约时间:'+time.strftime('%H:%M',self.checkTime)+' '
        buffer += ','.join(self.resvMembers)+' '
        buffer += self.Location
        return buffer
    def __repr__(self):
        return str(self)

