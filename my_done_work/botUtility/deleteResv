def deleteResv(uid,password,uuID):
    if not consume_token(('LIBIC0','LIBIC1','LIBIC2')):unavailable()
    sess,response = get_libic_session(uid,password)
    infos = response.json()['data']
    accountNo = infos['accNo']
    token = infos['token']
    headers = dict(token=token,lan='1')
    data = dict(uuid=uuID)
    response = sess.post('https://libic.nankai.edu.cn/ic-web/reserve/delete',headers=headers,json=data,proxies=proxies).json()
    return json.dumps(dict(msg = response['message']))


