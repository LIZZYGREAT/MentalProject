APP_ENV=production
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai

# Administrator service. Compose only exposes this on host 127.0.0.1.
ADMIN_ENABLED=true
ADMIN_HOST=0.0.0.0
# Host-side loopback port used by Compose / an SSH tunnel.
ADMIN_HOST_PORT=8081
# Container listener; Compose pins this to 8081 for the Admin service.
ADMIN_PORT=8081
ADMIN_USERNAME=
# Generate with: python -c "from app.admin_web.auth import hash_password; print(hash_password(input()))"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
# Enable only when the browser reaches Admin through HTTPS.
ADMIN_SECURE_COOKIE=false

# Public bot application: WebSocket ingress, replies and warnings.
FEISHU_BOT_APP_ID=
FEISHU_BOT_APP_SECRET=

# Calendar OAuth provider.
# Leave both empty to use the Bot App for Calendar as well.
FEISHU_CALENDAR_APP_ID=
FEISHU_CALENDAR_APP_SECRET=

# HTTPS endpoint used for interactive-card callbacks. Configure the same URL,
# Verification Token, and Encrypt Key in the Feishu developer console.
FEISHU_CARD_CALLBACK_ENABLED=false
FEISHU_CARD_CALLBACK_HOST=0.0.0.0
FEISHU_CARD_CALLBACK_PORT=8000
FEISHU_CARD_CALLBACK_PATH=/feishu/card/callback
FEISHU_CARD_VERIFICATION_TOKEN=
FEISHU_CARD_ENCRYPT_KEY=

# Keep one API key. The runtime maps it to ANTHROPIC_AUTH_TOKEN for Claude Code.
DEEPSEEK_API_KEY=
CLAUDE_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Primary selection plus the Claude Code aliases used by the DeepSeek gateway.
# Set OPUS and SONNET to the verified v4-pro ID.
# Set HAIKU and SUBAGENT to the same verified v4-flash ID.
CLAUDE_MODEL=
CLAUDE_DEFAULT_OPUS_MODEL=
CLAUDE_DEFAULT_SONNET_MODEL=
CLAUDE_DEFAULT_HAIKU_MODEL=
CLAUDE_CODE_SUBAGENT_MODEL=

POSTGRES_PASSWORD=4aa95813307981494882a94c436e5913942e249a9f86ff22
DATABASE_URL=postgresql+psycopg://mindflow:4aa95813307981494882a94c436e5913942e249a9f86ff22@postgres:5432/mindflow

# Generate 32 random bytes and encode them with URL-safe base64.
TOKEN_ENCRYPTION_KEY=

# Compose overrides these with the paths baked into the image.
CLAUDE_WORKDIR=../claude-runtime
CLAUDE_SETTINGS_PATH=../claude-runtime/.claude/settings.json

BOT_QUEUE_MAX_SIZE=100
PARTICIPANT_INPUT_QUEUE_SIZE=20
MAX_ACTIVE_AGENT_SESSIONS=2
TOOL_SYNC_MAX_CONCURRENCY=8
AGENT_SESSION_IDLE_SECONDS=120
CLAUDE_TIMEOUT_SECONDS=90
CLAUDE_MAX_TURNS=8

# Response UX. Final content is still sent only after the Safety postcheck.
PROGRESS_DELAY_SECONDS=3
PROGRESS_COOLDOWN_SECONDS=3
PROGRESS_MAX_MESSAGES=2
RESPONSE_SEGMENTATION_ENABLED=true
RESPONSE_SEGMENT_MIN_TOTAL_CHARS=320
RESPONSE_SEGMENT_TARGET_CHARS=260
RESPONSE_SEGMENT_MAX_CHARS=650
RESPONSE_MAX_SEGMENTS=3
# off disables the secondary presentation model; adaptive is the production
# default; always is intended for diagnostics and controlled comparison only.
PRESENTATION_AGENT_MODE=adaptive
PRESENTATION_AGENT_MIN_CHARS=600
PRESENTATION_AGENT_TIMEOUT_SECONDS=4
PRESENTATION_AGENT_DISCONNECT_TIMEOUT_SECONDS=0.5
PRESENTATION_AGENT_MAX_PENDING_CLEANUPS=1
PRESENTATION_AGENT_MAX_SEGMENTS=3
# Empty uses CLAUDE_CODE_SUBAGENT_MODEL.
PRESENTATION_MODEL=
# Telemetry only. Partial deltas are never sent to Feishu.
CLAUDE_PARTIAL_MESSAGES_ENABLED=false
FEISHU_SEND_MAX_RETRIES=1
FEISHU_GATEWAY_START_TIMEOUT_SECONDS=30
FEISHU_GATEWAY_STOP_TIMEOUT_SECONDS=8
FEISHU_GATEWAY_DEVICE_FLOW_CLOSE_TIMEOUT_SECONDS=8

# Dynamic Calendar -> Semantics -> Forecast -> Warning pipeline.
FORECAST_DAILY_PREPARE_LOCAL_TIME=07:30
FORECAST_CALENDAR_SYNC_INTERVAL_SECONDS=300
FORECAST_MAX_CONCURRENCY=1
SEMANTIC_API_ENABLED=false
SEMANTIC_API_URL=https://api.deepseek.com/chat/completions
SEMANTIC_API_MODEL=deepseek-v4-flash
SEMANTIC_API_TIMEOUT_SECONDS=8
SEMANTIC_MAX_CONCURRENCY=2
SEMANTIC_MATERIALITY_THRESHOLD=0.03
WARNING_POLL_INTERVAL_SECONDS=15
WARNING_LEAD_MINUTES=20
WARNING_LATE_GRACE_MINUTES=10
WARNING_MAX_ATTEMPTS=5
WARNING_RETRY_BASE_SECONDS=60
WARNING_CLAIM_LEASE_SECONDS=120
WARNING_EPISODE_DRIFT_MINUTES=15
WARNING_MAX_DAILY_SENDS=2
WARNING_MIN_INTERVAL_MINUTES=240
PROFILE_CALIBRATION_ENABLED=false

# Daily Review is a separate retrospective feedback pipeline. It does not
# overwrite Forecast snapshots or warning audit records.
# Keep disabled until the HTTPS card callback is configured and reachable.
DAILY_REVIEW_ENABLED=false
DAILY_REVIEW_LOCAL_TIME=22:00
DAILY_REVIEW_TIMEZONE=Asia/Shanghai
DAILY_REVIEW_POLL_INTERVAL_SECONDS=60
DAILY_REVIEW_RETRY_BASE_SECONDS=60
DAILY_REVIEW_MAX_ATTEMPTS=5
DAILY_REVIEW_CLAIM_LEASE_SECONDS=120
DAILY_REVIEW_VALIDITY_MINUTES=1440
DAILY_REVIEW_CATCH_UP_MINUTES=120
OBSERVATION_SMOOTHING_WINDOW_MINUTES=90
RETROSPECTIVE_MORNING_SIGMA_MINUTES=90
RETROSPECTIVE_END_SIGMA_MINUTES=60
RETROSPECTIVE_PEAK_RISE_MINUTES=120
RETROSPECTIVE_PEAK_DECAY_MINUTES=90
RETROSPECTIVE_MAX_DELTA_PER_5_MIN=0.35
DAILY_REVIEW_END_STATE_GAIN=0.35

# Compose resource fuses (sized for the current 2-vCPU / ~1.6-GiB host).
BOT_CPU_LIMIT=0.75
BOT_MEMORY_LIMIT=768m
BOT_MEMORY_SWAP_LIMIT=1280m
BOT_PID_LIMIT=128
POSTGRES_CPU_LIMIT=0.50
POSTGRES_MEMORY_LIMIT=512m
POSTGRES_MEMORY_SWAP_LIMIT=768m
POSTGRES_PID_LIMIT=100
ADMIN_CPU_LIMIT=0.35
ADMIN_MEMORY_LIMIT=384m
ADMIN_MEMORY_SWAP_LIMIT=512m
ADMIN_PID_LIMIT=64
