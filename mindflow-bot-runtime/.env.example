APP_ENV=production
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai

# Public bot application: WebSocket ingress, replies and warnings.
FEISHU_BOT_APP_ID=
FEISHU_BOT_APP_SECRET=

# Calendar OAuth provider.
# Leave both empty to use the Bot App for Calendar as well.
FEISHU_CALENDAR_APP_ID=
FEISHU_CALENDAR_APP_SECRET=

# Keep one API key. The runtime maps it to ANTHROPIC_AUTH_TOKEN for Claude Code.
DEEPSEEK_API_KEY=
CLAUDE_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Primary selection plus the Claude Code aliases used by the DeepSeek gateway.
# Set OPUS and SONNET to the verified v4-pro ID.
# Set HAIKU and SUBAGENT to the same verified v4-flash ID.
CLAUDE_MODEL=
CLAUDE_DEFAULT_OPUS_MODEL=
CLAUDE_DEFAULT_SONNET_MODEL=
CLAUDE_DEFAULT_HAIKU_MODEL=
CLAUDE_CODE_SUBAGENT_MODEL=

POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://mindflow:${POSTGRES_PASSWORD}@postgres:5432/mindflow

# Generate 32 random bytes and encode them with URL-safe base64.
TOKEN_ENCRYPTION_KEY=

# Compose overrides these with the paths baked into the image.
CLAUDE_WORKDIR=../claude-runtime
CLAUDE_SETTINGS_PATH=../claude-runtime/.claude/settings.json

BOT_QUEUE_MAX_SIZE=100
PARTICIPANT_INPUT_QUEUE_SIZE=20
MAX_ACTIVE_AGENT_SESSIONS=2
AGENT_SESSION_IDLE_SECONDS=120
CLAUDE_TIMEOUT_SECONDS=90
CLAUDE_MAX_TURNS=8

PROGRESS_DELAY_SECONDS=6
PROGRESS_COOLDOWN_SECONDS=8
PROGRESS_MAX_MESSAGES=2
FEISHU_SEND_MAX_RETRIES=1
FEISHU_GATEWAY_START_TIMEOUT_SECONDS=30
FEISHU_GATEWAY_STOP_TIMEOUT_SECONDS=8
FEISHU_GATEWAY_DEVICE_FLOW_CLOSE_TIMEOUT_SECONDS=8

# Dynamic Calendar -> Semantics -> Forecast -> Warning pipeline.
FORECAST_DAILY_PREPARE_LOCAL_TIME=07:30
FORECAST_CALENDAR_SYNC_INTERVAL_SECONDS=300
FORECAST_MAX_CONCURRENCY=1
SEMANTIC_API_ENABLED=false
SEMANTIC_API_URL=https://api.deepseek.com/chat/completions
SEMANTIC_API_MODEL=deepseek-v4-flash
SEMANTIC_API_TIMEOUT_SECONDS=8
SEMANTIC_MAX_CONCURRENCY=2
SEMANTIC_MATERIALITY_THRESHOLD=0.03
WARNING_POLL_INTERVAL_SECONDS=15
WARNING_LEAD_MINUTES=20
WARNING_LATE_GRACE_MINUTES=10
WARNING_MAX_ATTEMPTS=5
WARNING_RETRY_BASE_SECONDS=60
WARNING_CLAIM_LEASE_SECONDS=120
WARNING_EPISODE_DRIFT_MINUTES=15

# Compose resource fuses (sized for the current 2-vCPU / ~1.6-GiB host).
BOT_CPU_LIMIT=0.75
BOT_MEMORY_LIMIT=768m
BOT_MEMORY_SWAP_LIMIT=1280m
BOT_PID_LIMIT=128
POSTGRES_CPU_LIMIT=0.50
POSTGRES_MEMORY_LIMIT=512m
POSTGRES_MEMORY_SWAP_LIMIT=768m
POSTGRES_PID_LIMIT=100
