APP_ENV=production
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai

FEISHU_APP_ID=
FEISHU_APP_SECRET=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://mindflow:${POSTGRES_PASSWORD}@postgres:5432/mindflow

# Generate 32 random bytes and encode them with URL-safe base64.
TOKEN_ENCRYPTION_KEY=

CARE_SKILL_PATH=skills/mental-health-care/SKILL.md

BOT_QUEUE_MAX_SIZE=100
BOT_AGENT_WORKERS=2
BOT_HISTORY_LIMIT=16

AGENT_MAX_TOOL_STEPS=4
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_RETRIES=1
